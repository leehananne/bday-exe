{
  "name": "bday-exe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && concurrently -k -n worker,vite \"wrangler dev --port 8787\" \"vite\"",
    "build": "npm run tokens && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "typescript": "5.8",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.164.0"
  }
}
